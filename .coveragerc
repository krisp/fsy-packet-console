[run]
source = src
omit =
    */tests/*
    */venv/*
    */__pycache__/*
    */audio/*
    # Transient synthetic migration files created/removed by
    # tests/unit/test_migration_system.py::synthetic_migrations
    */src/migrations/m9[0-9][0-9]_synthetic_*.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

precision = 2

[html]
directory = htmlcov
